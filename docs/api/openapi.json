{
  "openapi": "3.1.0",
  "info": {
    "description": "Seller console API for AegisFleet: AI agents that guard a PayPal seller's payments, disputes, invoices and shipments. Agents never call PayPal directly; every action passes a guardrail gateway (kill switch, allowlist, caps, human approval) and is sealed into a hash-chained Proof Ledger.\n\nAuthenticate with HTTP Basic (`dev` or `judge`) or the session cookie set by `POST /api/login`.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://aegisfleet.solvor.co.in",
      "description": "Live demo (PayPal sandbox)"
    }
  ],
  "paths": {
    "/api/login": {
      "post": {
        "tags": [
          "console"
        ],
        "summary": "Login",
        "description": "Check a username and password and set a 12-hour session cookie.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Login required: HTTP Basic or the session cookie"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "tags": [
          "console"
        ],
        "summary": "Logout",
        "description": "Clear the session cookie.",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "401": {
            "description": "Login required: HTTP Basic or the session cookie"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "Me",
        "description": "Who is logged in, and whether they are the seller (dev) or a read-mostly judge.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Login required: HTTP Basic or the session cookie"
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    },
    "/api/summary": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "Summary",
        "description": "Overview numbers: money waiting on approval, open disputes, overdue invoices, health, chain state.",
        "operationId": "summary",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "401": {
            "description": "Login required: HTTP Basic or the session cookie"
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    },
    "/api/ledger": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "Ledger",
        "description": "Proof Ledger entries, newest first. Each entry's hash covers the previous one.",
        "operationId": "ledger",
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "name": "subject_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LedgerEntry"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Login required: HTTP Basic or the session cookie"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ledger/verify": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "Ledger Verify",
        "description": "Recompute every hash in the chain and report the first entry that no longer matches.",
        "operationId": "ledger_verify",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainVerify"
                }
              }
            }
          },
          "401": {
            "description": "Login required: HTTP Basic or the session cookie"
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    },
